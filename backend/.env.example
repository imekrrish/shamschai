# Environment Target: "development" (local PostgreSQL) or "production" (Railway PostgreSQL)
APP_ENV=development
NODE_ENV=development
PORT=5000

# 1. Local Development PostgreSQL (Default when running locally)
DATABASE_URL_LOCAL="postgresql://postgres:postgres@localhost:5432/shamschai_dev?schema=public"

# 2. Production Railway PostgreSQL (Set your Railway connection string here when ready)
DATABASE_URL_RAILWAY="postgresql://postgres:password@roundhouse.proxy.rlwy.net:port/railway?schema=public"

# Active Database URL (defaults to DATABASE_URL_LOCAL in development)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shamschai_dev?schema=public"

# JWT Authentication
JWT_SECRET="" # Generate a unique random secret; see RAZORPAY_SETUP.md
JWT_EXPIRES_IN="7d"

# Google OAuth (Obtained from Google Cloud Console)
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET=""

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:5173"
# Optional comma-separated aliases, for example:
# FRONTEND_URLS="https://www.shamschai.com,https://shamschai.com"

# Razorpay: backend only. Start with Test Mode keys.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# SMTP delivery for all backend-owned HTML emails
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="notifications@example.com"
SMTP_PASS=""
MAIL_FROM="Sham's Chai <notifications@example.com>"
# Team inbox that receives every internal notification.
EMAIL_NOTIFY_TO="your-team@example.com"

# Recommended for Railway: Brevo API uses HTTPS/443 and does not require SMTP ports.
BREVO_API_KEY=""
# Must be a sender Brevo has verified, or every send is rejected.
BREVO_SENDER_EMAIL="notifications@example.com"
BREVO_SENDER_NAME="Sham's Chai"
# Comma-separated addresses blind-copied on every mail the app sends.
EMAIL_BCC=""
